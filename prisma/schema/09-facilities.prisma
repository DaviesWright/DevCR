// Facilities & asset management, maintenance, and service charge billing.

enum AssetStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  RETIRED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ServiceChargeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model AssetCategory {
  id   String @id @default(cuid())
  name String @unique

  assets Asset[]

  @@map("asset_categories")
}

model Asset {
  id             String        @id @default(cuid())
  unitId         String?       @map("unit_id")
  unit           Unit?         @relation(fields: [unitId], references: [id])
  categoryId     String        @map("category_id")
  category       AssetCategory @relation(fields: [categoryId], references: [id])
  name           String
  qrCode         String?       @unique @map("qr_code")
  status         AssetStatus   @default(OPERATIONAL)
  warrantyExpiry DateTime?     @map("warranty_expiry")
  installedAt    DateTime?     @map("installed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([unitId])
  @@index([categoryId])
  @@index([status])
  @@map("assets")
}

model ServiceProvider {
  id          String   @id @default(cuid())
  companyName String   @map("company_name")
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  specialty   String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  maintenanceRequests  MaintenanceRequest[]
  maintenanceSchedules MaintenanceSchedule[]

  @@map("service_providers")
}

model MaintenanceRequest {
  id                String            @id @default(cuid())
  assetId           String            @map("asset_id")
  asset             Asset             @relation(fields: [assetId], references: [id])
  description       String
  status            MaintenanceStatus @default(SCHEDULED)
  assignedToId      String?           @map("assigned_to")
  assignedTo        User?             @relation("MaintenanceRequestAssignedTo", fields: [assignedToId], references: [id])
  serviceProviderId String?           @map("service_provider_id")
  serviceProvider   ServiceProvider?  @relation(fields: [serviceProviderId], references: [id])
  scheduledAt       DateTime?         @map("scheduled_at")
  completedAt       DateTime?         @map("completed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([status])
  @@map("maintenance_requests")
}

model MaintenanceSchedule {
  id                String           @id @default(cuid())
  assetId           String           @map("asset_id")
  asset             Asset            @relation(fields: [assetId], references: [id])
  serviceProviderId String?          @map("service_provider_id")
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  frequency         String
  nextDueAt         DateTime         @map("next_due_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([nextDueAt])
  @@map("maintenance_schedules")
}

model ServiceCharge {
  id            String              @id @default(cuid())
  unitId        String              @map("unit_id")
  unit          Unit                @relation(fields: [unitId], references: [id])
  developmentId String              @map("development_id")
  development   Development         @relation(fields: [developmentId], references: [id])
  periodStart   DateTime            @map("period_start")
  periodEnd     DateTime            @map("period_end")
  amount        Decimal             @db.Decimal(14, 2)
  currency      String              @default("USD")
  status        ServiceChargeStatus @default(PENDING)
  dueDate       DateTime            @map("due_date")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([status])
  @@map("service_charges")
}
