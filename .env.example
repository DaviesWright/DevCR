DATABASE_URL="postgresql://devcrm:devcrm_local_dev@localhost:5433/devcrm?schema=public"

# Email & calendar sync (Admin > Integrations) — optional. Leave blank to leave the feature
# disabled ("Not configured" in the UI); the rest of the app works fine without it.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Enable the Gmail API and Google Calendar API on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3010/api/integrations/google/callback"

# Azure Portal > App registrations > New registration. Add Microsoft Graph delegated
# permissions: Mail.Read, Calendars.Read, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3010/api/integrations/microsoft/callback"

# Dynamics 365 Business Central (Finance > BC Reconciliation) — optional. Leave blank to leave
# BC posting disabled; payments still record and mirror rows still get created in DevCRM, they
# just stay PENDING until these are set. Azure Portal > App registrations > New registration,
# API permissions > Dynamics 365 Business Central > Financials.ReadWrite.All (application
# permission, admin consent required) — this uses the client-credentials flow, no user sign-in.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT="production"
BC_COMPANY_ID=
